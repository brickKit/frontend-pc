{
  "name": "frontend-pc",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0 && node scripts/check-styles.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "compose": "node packages/build/src/cli.ts",
    "build": "pnpm compose && vite build",
    "lint:proof": "bash scripts/lint-proof.sh"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-vue": "6.0.11",
    "@vue/test-utils": "2.6.0",
    "eslint": "10.15.0",
    "eslint-plugin-vue": "10.12.1",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "vue-eslint-parser": "10.4.2",
    "vue-tsc": "3.3.14"
  }
}
